<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, and every package is mapped to it explicitly: a feed added by a machine-wide or user-level config
       (or a typo in a package name) can never be resolved from somewhere else. <clear/> drops inherited sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
