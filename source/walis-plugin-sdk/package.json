{
  "name": "@walisayu/plugin-sdk",
  "version": "0.1.1",
  "description": "Types, local test harness and bundling CLI for developing Walis plugins",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "walis-plugin": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "homepage": "https://walis.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walisayu/walis.git",
    "directory": "source/walis-plugin-sdk"
  },
  "keywords": [
    "walis",
    "ci",
    "cd",
    "plugin",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  }
}
