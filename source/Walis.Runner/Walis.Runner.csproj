<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\Walis.Core\Walis.Core.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>walis-runner</AssemblyName>
        <RootNamespace>Walis.Runner</RootNamespace>
        <InvariantGlobalization>false</InvariantGlobalization>
        <RuntimeIdentifiers>$(WalisReleaseRuntimeIdentifiers)</RuntimeIdentifiers>
    </PropertyGroup>

</Project>
